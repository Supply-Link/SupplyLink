# Direct backend URL. For local dev this hits the backend on port 8080.
# For production (e.g. Render), set the deployed backend URL including /api.
# Example: VITE_API_BASE_URL=https://your-service.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Optional: set only if you want to use the Vite dev-server proxy instead of a
# direct backend URL above. Set VITE_API_BASE_URL=/api to activate the proxy.
# API_PROXY_TARGET=http://127.0.0.1:8080
