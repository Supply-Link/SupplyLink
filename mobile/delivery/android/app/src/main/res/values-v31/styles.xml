<resources>
  <!-- Android 12+ ignores windowBackground for the launch splash; it needs these explicit attributes. -->
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowSplashScreenBackground">@color/splashscreen_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
  </style>
</resources>
